---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import type { JsonLd } from '../types';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: JsonLd[];
  noindex?: boolean;
}
const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0277bd" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} path={path} jsonLd={jsonLd} noindex={noindex} />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand-dark focus:px-4 focus:py-3 focus:font-semibold focus:text-white"
      >Pular para o conteúdo</a
    >
    <Header />
    <main id="conteudo" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
    <aside aria-label="Atalho para WhatsApp">
      <WhatsAppButton />
    </aside>
  </body>
</html>
