---
import { waLink } from '../lib/whatsapp';

interface Props {
  h1: string;
  subtitle: string;
  eyebrow?: string;
  waMessage?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  h1,
  subtitle,
  eyebrow,
  waMessage = 'Olá! Vim pelo site e gostaria de um orçamento de ar-condicionado.',
  secondaryHref = '/#servicos',
  secondaryLabel = 'Ver serviços',
} = Astro.props;
---

<section class="bg-gradient-to-br from-brand to-brand-dark text-white">
  <div class="container-x py-12 md:py-20">
    {eyebrow && <p class="mb-3 inline-block rounded-full bg-white px-3 py-1 text-sm font-semibold text-accent-strong">{eyebrow}</p>}
    <h1 class="max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl md:text-5xl">{h1}</h1>
    <p class="mt-4 max-w-2xl text-lg text-white">{subtitle}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={waLink(waMessage)} target="_blank" rel="noopener" class="btn bg-white text-wa hover:bg-ice">
        Pedir orçamento no WhatsApp
      </a>
      <a href={secondaryHref} class="btn-ghost">{secondaryLabel}</a>
    </div>
  </div>
</section>
