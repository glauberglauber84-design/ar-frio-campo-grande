---
import { waLink } from '../lib/whatsapp';

interface Props {
  h1: string;
  subtitle: string;
  eyebrow?: string;
  waMessage?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  h1,
  subtitle,
  eyebrow,
  waMessage = 'Olá! Vim pelo site e gostaria de um orçamento de ar-condicionado.',
  secondaryHref = '/#servicos',
  secondaryLabel = 'Ver serviços',
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand to-brand-dark text-white">
  <svg
    class="hero-drift pointer-events-none absolute -right-24 -top-24 h-96 w-96 text-white opacity-[0.08] md:-right-12 md:h-128 md:w-128"
    viewBox="0 0 200 200"
    fill="none"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <g>
      <path d="M100 8v184M20.200 54l159.600 92M20.200 146l159.600-92"></path>
      <path d="M100 30l-14-14M100 30l14-14M100 170l-14 14M100 170l14 14"></path>
      <path d="M36 62l-2-20M36 62l-20 2M164 138l2 20M164 138l20-2M36 138l-20-2M36 138l-2 20M164 62l20 2M164 62l2-20"></path>
      <circle cx="100" cy="100" r="34"></circle>
      <circle cx="100" cy="100" r="64"></circle>
    </g>
  </svg>
  <div class="container-x relative py-12 md:py-20">
    {eyebrow && <p class="mb-4 inline-block rounded-full bg-white px-3 py-1 text-sm font-semibold text-accent-strong">{eyebrow}</p>}
    <h1 class="max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl">{h1}</h1>
    <p class="mt-4 max-w-2xl text-lg text-white md:text-xl">{subtitle}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={waLink(waMessage)} target="_blank" rel="noopener" class="btn bg-white text-wa hover:bg-ice">
        Pedir orçamento no WhatsApp
      </a>
      <a href={secondaryHref} class="btn-ghost">{secondaryLabel}</a>
    </div>
  </div>
</section>
