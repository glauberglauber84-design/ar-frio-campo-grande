---
import { loadLocais, pathOf } from '../lib/locais';

interface Props {
  excludeSlug?: string;
  heading?: string;
  headingLevel?: 'h2' | 'h3';
}
const { excludeSlug, heading = 'Nossos serviços', headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const servicos = loadLocais().filter((s) => s.servico !== excludeSlug);
---

<section id="servicos" class="section-y">
  <div class="container-x">
    <Heading class="h2">{heading}</Heading>
    <p class="mt-2 max-w-2xl text-muted">Escolha o serviço e veja os bairros de Campo Grande que atendemos.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {servicos.map((s) => (
        <li>
          <a href={pathOf(s)} class:list={['card block h-full', s.servicoPrincipal && 'border-brand-dark ring-2 ring-brand-dark/30']}>
            {s.servicoPrincipal && <span class="mb-2 inline-block rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">Mais pedido</span>}
            <span class="block text-lg font-semibold leading-snug text-accent-strong">{s.servicoLabel}</span>
            <span class="mt-2 block text-sm text-muted">Atendemos {s.bairros.length} bairros em {s.cidadeLabel}</span>
            <span class="mt-3 inline-block font-semibold text-accent-strong underline underline-offset-4">Ver detalhes</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
