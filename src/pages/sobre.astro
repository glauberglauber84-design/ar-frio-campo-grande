---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../config/siteConfig';
import { breadcrumbLd, localBusinessLd } from '../lib/schema';
import { waLink } from '../lib/whatsapp';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Sobre', path: '/sobre/' },
];
---

<BaseLayout
  title={`Sobre a ${siteConfig.name} | Ar-condicionado`}
  description={`Conheça a ${siteConfig.name}: instalação e manutenção de ar-condicionado em Campo Grande-MS, com atendimento direto pelo WhatsApp.`}
  path="/sobre/"
  jsonLd={[localBusinessLd(), breadcrumbLd(crumbs)]}
>
  <Breadcrumb items={crumbs} />
  <section class="section-y">
    <div class="container-x">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Sobre a {siteConfig.name}</h1>
      <p class="prose-x mt-5">
        A {siteConfig.name} atende {siteConfig.address.city}-{siteConfig.address.state} com instalação, manutenção preventiva e corretiva, limpeza, recarga de gás e manutenção preventiva recorrente para empresas.
      </p>
      <p class="prose-x mt-4">
        Nosso foco é resolver com clareza: explicamos o que precisa ser feito, passamos o orçamento no mesmo dia (por foto, vídeo e, se necessário, visita no local) e entregamos o serviço com teste de vazamento e garantia.
      </p>
      <p class="prose-x mt-4">Responsável: {siteConfig.responsavel}.</p>
      <a href={waLink('Olá! Vim pelo site e gostaria de falar com vocês.')} target="_blank" rel="noopener" class="btn-wa mt-6">Falar no WhatsApp</a>
    </div>
  </section>
</BaseLayout>
